<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WarcasketStatTuner</AssemblyName>
    <RootNamespace>WarcasketStatTuner</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.6'">..\1.6\Assemblies\</OutputPath>
    <OutputPath Condition="'$(RimWorldVersion)' == '1.7'">..\1.7\Assemblies\</OutputPath>
    <!-- Optional: override with -p:RimWorldManagedPath="..." -->
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == ''">..\..\..\RimWorldWin64_Data\Managed</RimWorldManagedPath>
    <!-- Optional: override with -p:HarmonyPath="...\0Harmony.dll" -->
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">..\..\2009463077\1.6\Assemblies\0Harmony.dll</HarmonyPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldVersion)' != '1.7'">
    <Reference Include="netstandard">
      <HintPath>$(RimWorldManagedPath)\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedPath)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>